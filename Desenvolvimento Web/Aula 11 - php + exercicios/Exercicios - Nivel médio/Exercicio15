//15. Verificador de Sequência: Dado um número inteiro positivo, verifique se ele é um 
//"número perfeito" (um número cuja soma de seus divisores próprios é igual a ele 
//mesmo, como o 6: 1+2+3 = 6).


echo "\n *************  VERIFICADOR DE SEQUÊNCIA  ************* \n\n";  

echo "Digite um número inteiro positivo: \n";
$numero = readline();

function verificarNumeroPerfeito(int $num) {
    $somaDivisores = 0;

    for ($i = 1; $i < $num; $i++) {
        if ($num % $i === 0) {
            $somaDivisores += $i;
        }
    }

    return $somaDivisores === $num;
}


if (verificarNumeroPerfeito($numero)) {
    echo "\n $numero é um número perfeito.\n";
} else {
    echo "\n $numero não é um número perfeito.\n";
}

