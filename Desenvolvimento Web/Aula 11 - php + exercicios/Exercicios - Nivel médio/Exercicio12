<?php
//12. Validador de Acesso: O sistema só permite a entrada se o usuário digitar a senha 
//correta. Ele tem apenas 3 tentativas. Se errar as 3, o sistema deve informar "Conta 
//Bloqueada".



echo "\n ***********  CRIAR USUARIO *********** \n";
$nome = readline("Digite o nome do usuario: ");
$senha = readline("Digite a senha do usuario: ");

echo "\n ***********  VALIDAR ACESSO *********** \n";
$tentativas = 3;

while ($tentativas > 0) {
    $senhaDigitada = readline("Digite a senha para acessar: ");
    
    if ($senhaDigitada === $senha) {
        echo "Acesso permitido. Bem-vindo, $nome!\n";
        break;
    } else {
        $tentativas--;
        echo "Senha incorreta. Tentativas restantes: $tentativas\n";
        
        if ($tentativas === 0) {
            echo "Conta Bloqueada.\n";
        }
    }
}



